# ==========================================================
# Application Settings
# ==========================================================

# Maximum upload size in bytes
MAX_SIZE=5242880

# Number of uploaded files per request
MAX_UPLOAD_FILES=4


# ==========================================================
# LLM Chat Endpoint
# ==========================================================

# URL of the running llama.cpp OpenAI-compatible server
LLAMA_CHAT_URL=http://127.0.0.1:8080/v1/chat/completions

# Model name used by the extraction service
LLM_MODEL_NAME=llama3.2:3b-instruct-q4_K_M


# ==========================================================
# llama.cpp Server
# ==========================================================

# Path to llama-server executable
LLAMA_SERVER_EXECUTABLE=/path/to/llama-server

# Path to the GGUF chat model
LLAMA_SERVER_MODEL_PATH=models/Llama-3.2-3B-Instruct-Q4_K_M.gguf

# Working directory of llama.cpp
LLAMA_SERVER_WORKDIR=/path/to/llama

LLAMA_SERVER_HOST=127.0.0.1
LLAMA_SERVER_PORT=8080

LLAMA_SERVER_CONTEXT_SIZE=4096
LLAMA_SERVER_GPU_LAYERS=32
LLAMA_SERVER_FLASH_ATTENTION=on
LLAMA_SERVER_THREADS=6


# ==========================================================
# GLM OCR
# ==========================================================

# Path to llama-mtmd-cli executable
LLAMA_CLI_PATH=/path/to/llama-mtmd-cli

# Root llama.cpp directory
LLAMA_DIR=/path/to/llama

# OCR model
GLM_OCR_MODEL=models/GLM-OCR.Q4_K_M.gguf

# OCR multimodal projector
GLM_MMPROJ=models/mmproj-GLM-OCR-Q4_K_M.gguf

N_GPU_LAYERS=99
CONTEXT_SIZE=4096