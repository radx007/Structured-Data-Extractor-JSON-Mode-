# App Settings
MAX_SIZE=5242880
MAX_UPLOAD_FILES=4

# LLM / Ollama Settings (examples)
LLM_MODEL="llama3.2:3b-instruct-q4_K_M"
OLLAMA_URL="http://localhost:11434/api/generate"

# GLM OCR Settings (examples)
LLAMA_CLI_PATH="C:/path/to/llama/llama-mtmd-cli.exe"
LLAMA_DIR="C:/path/to/llama"
GLM_OCR_MODEL="/path/to/models/GLM-OCR.Q4_K_M.gguf"
GLM_MMPROJ="/path/to/models/mmproj-GLM-OCR-Q4_K_M.gguf"
N_GPU_LAYERS=99
CONTEXT_SIZE=4096