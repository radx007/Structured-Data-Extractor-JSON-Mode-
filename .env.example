# App Settings
MAX_SIZE=5242880
MAX_UPLOAD_FILES=4

# LLM / llama.cpp chat
LLAMA_CHAT_URL="http://127.0.0.1:8080/v1/chat/completions"
LLM_MODEL_NAME="llama3.2:3b-instruct-q4_K_M"

# llama.cpp LLM server
LLAMA_SERVER_EXECUTABLE="/usr/local/bin/llama-server"
LLAMA_SERVER_MODEL_PATH="/models/Llama-3.2-3B-Instruct-Q4_K_M.gguf"
LLAMA_SERVER_WORKDIR="/usr/local/bin"
LLAMA_SERVER_HOST="127.0.0.1"
LLAMA_SERVER_PORT=8080
LLAMA_SERVER_CONTEXT_SIZE=4096
LLAMA_SERVER_GPU_LAYERS=32
LLAMA_SERVER_FLASH_ATTENTION="on"
LLAMA_SERVER_THREADS=6

# GLM-OCR persistent server (port 8081, separate from LLM)
GLM_SERVER_HOST="127.0.0.1"
GLM_SERVER_PORT=8081
GLM_OCR_MODEL="/models/GLM-OCR.Q4_K_M.gguf"
GLM_MMPROJ="/models/mmproj-GLM-OCR-Q4_K_M.gguf"
N_GPU_LAYERS=99
CONTEXT_SIZE=4096
