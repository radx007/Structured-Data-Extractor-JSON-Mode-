# Path to the llama-cpp-python or llama-mtmd executable
LLAMA_CLI_PATH=/path/to/your/llama-cli.exe

# The working directory where the CLI should execute (usually the tool's folder)
LLAMA_DIR=/path/to/llama/folder

# Relative or absolute paths to the model files
GLM_OCR_MODEL=models/GLM-OCR.Q4_K_M.gguf
GLM_MMPROJ=models/mmproj-GLM-OCR-Q4_K_M.gguf